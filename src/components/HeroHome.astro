---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="container hero-inner">
    <h1>{t('hero.title')}</h1>
    <p class="hero-tagline" set:html={t('hero.tagline')}></p>
  </div>
</section>
