---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductPage from '../../../components/ProductPage.astro';
import { useTranslations, languages, defaultLang, type Lang } from '../../../i18n/utils';
import { softwareSchema } from '../../../data/schema';

export const getStaticPaths = (() =>
  Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((l) => ({ params: { lang: l } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const description = t('gmcoptimizer.metaDescription');
---

<BaseLayout
  title={t('gmcoptimizer.metaTitle')}
  description={description}
  lang={lang}
  canonicalPath="/gmcoptimizer"
  ogType="product"
  schema={softwareSchema(lang, description)}
  showLegalLinks
>
  <ProductPage lang={lang} />
</BaseLayout>
